# Copiar a .env y completar. El archivo .env NUNCA se sube a Git.
APP_NAME="SGC Psicología"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tudominio.com/sistema
APP_TIMEZONE=America/Guayaquil

DB_HOST=localhost
DB_PORT=3306
DB_NAME=psicologia
DB_USER=
DB_PASS=

# Ruta absoluta FUERA del directorio público (uploads, documentos, respaldos, logs)
STORAGE_PATH=/var/www/psicologia-storage
MAX_UPLOAD_MB=10
SESSION_IDLE_MINUTES=60
