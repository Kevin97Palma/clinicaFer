Options -Indexes

# Proteger archivos sensibles
<FilesMatch "\.(env|sql|py|log|md|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger directorios de sistema
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso directo a /storage/
    RewriteRule ^storage/(.*)$ /modules/errors/403.php [L,F]

    # Bloquear acceso a /database/
    RewriteRule ^database/(.*)$ /modules/errors/403.php [L,F]

    # Bloquear acceso a /config/
    RewriteRule ^config/(.*)$ /modules/errors/403.php [L,F]
</IfModule>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Encoding UTF-8
AddDefaultCharset UTF-8
