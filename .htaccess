# Cuando el hosting apunta a la raíz del proyecto (no a /public):
# todo se reescribe hacia public/, por lo que app/, config/, database/, storage/ y .env
# nunca son accesibles por URL.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.|\.(env|sql|log|md|gz|ini|lock|json|py|sh)$">
    Require all denied
</FilesMatch>
