Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Archivos estáticos existentes se sirven directo; todo lo demás al front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(env|sql|log|md|gz|ini|lock)$">
    Require all denied
</FilesMatch>

AddDefaultCharset UTF-8
